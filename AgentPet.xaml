<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="AgentPet v1.6.0 · 智能体桌宠" Width="390" Height="390" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="{x:Null}"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        FontFamily="Microsoft YaHei UI, Segoe UI" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="ThemeAccentBrush" Color="#FFCE6018"/>
    <SolidColorBrush x:Key="ThemeHoverBrush" Color="#22CE6018"/>
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
    </Style>
    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="BtnBody" Background="{TemplateBinding Background}" CornerRadius="6" Padding="4,2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="BtnBody" Property="Background" Value="{DynamicResource ThemeHoverBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <sys:String x:Key="DetailWindowXaml" xml:space="preserve"><![CDATA[
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AgentPet 任务详情"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="{x:Null}" ShowInTaskbar="False" ShowActivated="False"
        Focusable="False" Topmost="True" SizeToContent="WidthAndHeight"
        FontFamily="Microsoft YaHei UI, Segoe UI" UseLayoutRounding="True">
  <Grid x:Name="DetailRootGrid" Margin="10,6,10,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Polygon x:Name="DetailArrowTop" Grid.Row="0" Points="0,7 7,0 14,7"
             Fill="#FFFFF6EC" Stroke="#FFE28532" StrokeThickness="1.6"
             StrokeLineJoin="Round" HorizontalAlignment="Center" Margin="0,0,0,-1.5" Panel.ZIndex="2"/>
    <Border x:Name="DetailCardBorder" Grid.Row="1" MinWidth="264" MaxWidth="360"
            Background="#FFFFF6EC" BorderBrush="#FFE28532" BorderThickness="1.8"
            CornerRadius="15" Padding="12,10" Panel.ZIndex="1">
      <Border.Effect>
        <DropShadowEffect Color="#555E2F0D" BlurRadius="14" ShadowDepth="3" Opacity="0.28"/>
      </Border.Effect>
      <StackPanel x:Name="DetailCardStack">
        <Grid x:Name="DetailHeaderGrid" Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="DetailTitleText" Grid.Column="0" Text="任务详情"
                     FontSize="12.5" FontWeight="Bold" Foreground="#FF4A2E1B" VerticalAlignment="Center"/>
          <Border x:Name="DetailSourcePill" Grid.Column="1" HorizontalAlignment="Right"
                  Background="#FFEFF6FF" BorderBrush="#FFBFDBFE" BorderThickness="1.0"
                  CornerRadius="10" Padding="6,2,7,2" Margin="8,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Image x:Name="DetailSourceIcon" Width="12" Height="12" Margin="0,0,4,0"
                     VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
              <TextBlock x:Name="DetailSourceMetaText" Text="Antigravity · 工作中"
                         FontSize="10" FontWeight="SemiBold" Foreground="#FF1D4ED8" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
        </Grid>
        <Border x:Name="DetailHintBanner" Background="#FFFFEAD3" BorderBrush="#FFF7D9BC"
                BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,0,0,7" Visibility="Visible">
          <TextBlock x:Name="DetailHintText" Text="状态提示：正在执行"
                     FontSize="10.5" Foreground="#FF8F5B36" TextWrapping="Wrap"/>
        </Border>
        <ScrollViewer x:Name="DetailScrollViewer" MaxHeight="220"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False" PanningMode="VerticalOnly">
          <TextBlock x:Name="DetailBodyText" Text="" FontSize="12"
                     LineStackingStrategy="BlockLineHeight" LineHeight="18"
                     TextWrapping="Wrap" Foreground="#FF4A2E1B"/>
        </ScrollViewer>
        <Border x:Name="DetailFooterBorder" BorderBrush="#FFF3E2D2" BorderThickness="0,1,0,0"
                Margin="0,8,0,0" Padding="0,6,0,0">
          <TextBlock x:Name="DetailFooterText" Text="同源会话：1 个"
                     FontSize="10.5" Foreground="#FF8F5B36" TextWrapping="Wrap"/>
        </Border>
      </StackPanel>
    </Border>
    <Polygon x:Name="DetailArrowBottom" Grid.Row="2" Points="0,0 14,0 7,7"
             Fill="#FFFFF6EC" Stroke="#FFE28532" StrokeThickness="1.6"
             StrokeLineJoin="Round" HorizontalAlignment="Center" Margin="0,-1.5,0,0"
             Panel.ZIndex="2" Visibility="Collapsed"/>
  </Grid>
</Window>
    ]]></sys:String>
  </Window.Resources>

  <Viewbox x:Name="ScaleHost" Stretch="Uniform">
    <Canvas x:Name="AnimationStage" Width="390" Height="390">
      <Canvas x:Name="Root" Canvas.Left="8" Canvas.Top="8" Width="374" Height="374" RenderTransformOrigin="0.5,1.0">
        <Canvas.RenderTransform>
          <TransformGroup>
            <ScaleTransform x:Name="FacingScale" ScaleX="1.0" ScaleY="1.0"/>
          </TransformGroup>
        </Canvas.RenderTransform>

        <!-- Main Speech Bubble (Scheme 3 Journal Card + Attached Droplet Tail Panel) -->
        <Grid x:Name="Bubble" Canvas.Left="30" Canvas.Top="41" Width="254" Height="Auto" Cursor="Hand" Opacity="0" Visibility="Hidden" RenderTransformOrigin="0.50,0.831">
          <Grid.RenderTransform>
            <ScaleTransform x:Name="BubbleScale" ScaleX="1.0" ScaleY="1.0"/>
          </Grid.RenderTransform>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border x:Name="BubbleBorder" Grid.Row="0" Width="254" MinHeight="72" MaxHeight="128" Background="#FFFFF6EC" BorderBrush="#FFE28532" BorderThickness="2.2" CornerRadius="18" Padding="0">
            <Border.Effect>
              <DropShadowEffect x:Name="BubbleShadow" BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.26" Color="#885E2F0D"/>
            </Border.Effect>
            <Grid x:Name="SceneText" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <ScaleTransform x:Name="TextFacingScale" ScaleX="1.0" ScaleY="1.0"/>
              </Grid.RenderTransform>

              <!-- 1. Work Status Mode (Two-Tier Journal Banner + Watermark Body) -->
              <Grid x:Name="WorkStatusPanel" Visibility="Collapsed" VerticalAlignment="Stretch" Margin="0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border x:Name="WorkHeaderBanner" Grid.Row="0" BorderBrush="#FFF7D9BC" BorderThickness="0,0,0,1" CornerRadius="15.8,15.8,0,0" Padding="12,6,11,6">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop x:Name="WorkHeaderGradStop0" Color="#FFFFEAD3" Offset="0"/>
                      <GradientStop x:Name="WorkHeaderGradStop1" Color="#FFFFF2E2" Offset="1"/>
                    </LinearGradientBrush>
                  </Border.Background>
                  <StackPanel>
                    <Grid x:Name="WorkHeaderRow" Margin="0" Background="Transparent">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Border x:Name="WorkStateChip" Grid.Column="0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0" Padding="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <Ellipse x:Name="WorkDot" Width="8.5" Height="8.5" Fill="#FFCE6018" VerticalAlignment="Center" Margin="0,0,6,0"/>
                          <TextBlock x:Name="WorkHeader" Text="工作中" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#FFCE6018"/>
                        </StackPanel>
                      </Border>
                      <TextBlock x:Name="WorkCoopHintInline" Grid.Column="1" Text=" · 同时活跃" FontSize="9.5" FontWeight="SemiBold" Foreground="#FFA66838" VerticalAlignment="Center" Visibility="Collapsed" TextTrimming="CharacterEllipsis" Margin="2,0,0,0"/>
                      <Grid x:Name="WorkInlineSourceHost" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed" Background="Transparent"/>
                    </Grid>
                    <WrapPanel x:Name="WorkSourcesPanel" Orientation="Horizontal" Margin="0,3.5,0,0" Background="Transparent" Visibility="Collapsed">
                      <Border x:Name="WorkSourceBadge" Background="#DDFFFFFF" BorderBrush="#FFBFDBFE" BorderThickness="0.9" CornerRadius="8.5" Padding="5,1,5.5,1" Margin="0,0,4,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <Image x:Name="WorkSourceIcon" Width="13" Height="13" Margin="0,0,4,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                          <TextBlock x:Name="WorkSource" Text="Antigravity" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" Foreground="#FF1D4ED8"/>
                          <TextBlock x:Name="WorkSourceCount" Text="×2" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#FF64748B" Visibility="Collapsed"/>
                        </StackPanel>
                      </Border>
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <Grid x:Name="WorkBodyArea" Grid.Row="1" Background="Transparent" ClipToBounds="True">
                  <TextBlock x:Name="WorkBodyWatermark" Text="✧" FontSize="28" Foreground="#24CE6018" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,4" Panel.ZIndex="0"/>
                  <Grid x:Name="WorkContentGroup" VerticalAlignment="Top" Margin="13,9,13,11" Panel.ZIndex="1">
                    <TextBlock x:Name="WorkTask" Text="正在梳理接下来要做什么" FontSize="12.5" TextWrapping="Wrap" LineStackingStrategy="BlockLineHeight" LineHeight="18" VerticalAlignment="Top" TextTrimming="CharacterEllipsis" Foreground="#FF4A2E1B" Background="Transparent"/>
                  </Grid>
                </Grid>
              </Grid>

              <!-- 2. Quota Mode (GPT-Niang generous style) -->
              <StackPanel x:Name="QuotaPanel" Visibility="Visible" VerticalAlignment="Center">
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="QuotaSourceIcon" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="QuotaHeader" Text="Codex 剩余额度" FontSize="12.5" FontWeight="Bold" Foreground="#FFCE6018" VerticalAlignment="Center"/>
                    <Border x:Name="QuotaPlanBadge" Visibility="Collapsed" Background="#FFF6E8DC" CornerRadius="5" Padding="6,1.5" Margin="7,0,0,0" VerticalAlignment="Center">
                      <TextBlock x:Name="QuotaPlanText" Text="Plus" FontSize="11" FontWeight="SemiBold" Foreground="#FFA65518"/>
                    </Border>
                  </StackPanel>
                  <TextBlock x:Name="QuotaResetNotice" Grid.Column="1" Text="" FontSize="11" Foreground="#FFA66838" VerticalAlignment="Center" Margin="0,0,5,0"/>
                  <Button x:Name="RefreshQuotaBtn" Grid.Column="2" Style="{StaticResource IconBtn}" Width="24" Height="22" Content="↻" FontSize="14" FontWeight="Bold" ToolTip="立即刷新 Codex 额度"/>
                </Grid>

                <!-- 5h Row -->
                <Grid Margin="0,2,0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="ShortLabel" Grid.Column="0" Text="5 小时" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Bottom" Foreground="#FF8F5B36"/>
                  <TextBlock x:Name="ShortReset" Grid.Column="1" Text="实时同步中" FontSize="12" VerticalAlignment="Bottom" Margin="8,0,0,2" Foreground="#FFA66838" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="ShortPercent" Grid.Column="2" Text="100%" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="18" FontWeight="Bold" VerticalAlignment="Bottom" Foreground="#FFBA4E0E"/>
                </Grid>
                <Border x:Name="ShortTrack" Height="5" Background="#FFF3E4D6" CornerRadius="3">
                  <Border x:Name="ShortBar" Height="5" Background="#FFE5802D" CornerRadius="2.5" Width="0" HorizontalAlignment="Left"/>
                </Border>

                <!-- Weekly Row -->
                <Grid Margin="0,7,0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="WeekLabel" Grid.Column="0" Text="每周" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Bottom" Foreground="#FF8F5B36"/>
                  <TextBlock x:Name="WeekReset" Grid.Column="1" Text="实时同步中" FontSize="12" VerticalAlignment="Bottom" Margin="8,0,0,2" Foreground="#FFA66838" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="WeekPercent" Grid.Column="2" Text="71%" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="18" FontWeight="Bold" VerticalAlignment="Bottom" Foreground="#FFBA4E0E"/>
                </Grid>
                <Border x:Name="WeekTrack" Height="5" Background="#FFF3E4D6" CornerRadius="3">
                  <Border x:Name="WeekBar" Height="5" Background="#FFE5802D" CornerRadius="2.5" Width="0" HorizontalAlignment="Left"/>
                </Border>
              </StackPanel>

              <!-- 3. Character Quote Mode -->
              <StackPanel x:Name="QuotePanel" Visibility="Collapsed" VerticalAlignment="Center">
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="QuoteSpeaker" Grid.Column="0" Text="Claude娘（小克）" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#FFCE6018"/>
                  <Border x:Name="QuoteHintBadge" Grid.Column="1" Background="#FFF5E8DC" CornerRadius="6" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="QuoteHint" Text="换一句 ↻" FontSize="10" FontWeight="SemiBold" Foreground="#FFA65518" VerticalAlignment="Center"/>
                  </Border>
                </Grid>
                <TextBlock x:Name="QuoteText" Text="诗人的灵感可没有枯竭，红茶也正好泡好~" FontSize="13.5" TextWrapping="Wrap" MaxHeight="72" LineHeight="20" FontWeight="Normal" TextTrimming="CharacterEllipsis" Foreground="#FF4D3322"/>
              </StackPanel>
              <!-- 4. DeepSeek Balance Mode -->
              <StackPanel x:Name="DeepSeekPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <Grid x:Name="DeepSeekHeaderGrid" Margin="0,0,0,5">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="DeepSeekIcon" Width="13" Height="13" Margin="0,0,3,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="DeepSeekHeader" Text="DeepSeek 官方余额" FontSize="12.5" FontWeight="Bold" Foreground="#FFCE6018" VerticalAlignment="Center"/>
                    <Border x:Name="DeepSeekBadge" Visibility="Visible" Background="#FFF7E6D5" CornerRadius="5" Padding="3.5,0.5" Margin="3,0,0,0" VerticalAlignment="Center">
                      <TextBlock x:Name="DeepSeekBadgeText" Text="官方" FontSize="9.5" FontWeight="SemiBold" Foreground="#FFAA5314"/>
                    </Border>
                  </StackPanel>
                  <TextBlock x:Name="DeepSeekStatusNotice" Grid.Row="0" Grid.Column="1" Text="" FontSize="10.0" Foreground="#FFA66838" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="NoWrap" Margin="2,0,2,0"/>
                  <Button x:Name="RefreshDeepSeekBtn" Grid.Row="0" Grid.Column="2" Style="{StaticResource IconBtn}" MinWidth="18" MinHeight="18" Padding="1,0" Content="↻" FontSize="12.5" FontWeight="Bold" ToolTip="立即刷新 DeepSeek 余额"/>
                </Grid>

                <!-- Balance Content Container -->
                <Grid x:Name="DeepSeekContentGrid" MinHeight="56">
                  <!-- State A: Configured & OK / Stale Balance Display -->
                  <StackPanel x:Name="DeepSeekOkPanel" Visibility="Visible" VerticalAlignment="Center">
                    <Grid x:Name="DeepSeekMainRowGrid" Margin="0,1,0,1">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock x:Name="DeepSeekCurrencyLabel" Grid.Row="0" Grid.Column="0" Text="人民币 CNY" FontSize="10.8" FontWeight="SemiBold" VerticalAlignment="Bottom" Foreground="#FF8F5B36" Margin="0,0,0,0" TextWrapping="Wrap"/>
                      <TextBlock x:Name="DeepSeekAvailableNotice" Grid.Row="0" Grid.Column="1" Text="" FontSize="9.5" VerticalAlignment="Bottom" Margin="4,0,4,1" Foreground="#FFE11D48" FontWeight="SemiBold"/>
                      <TextBlock x:Name="DeepSeekTotalText" Grid.Row="0" Grid.Column="2" Text="¥ 0.00" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="18" FontWeight="Bold" VerticalAlignment="Bottom" Foreground="#FFBA4E0E" Margin="4,0,0,0"/>
                    </Grid>
                    <Grid x:Name="DeepSeekSubRowGrid" Margin="0,3,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock x:Name="DeepSeekBreakdownText" Grid.Column="0" Text="充值: ¥0.00  赠送: ¥0.00" FontSize="10.0" Foreground="#FFA66838" TextWrapping="Wrap" VerticalAlignment="Center"/>
                      <TextBlock x:Name="DeepSeekPricingLink" Grid.Column="1" Text="官方计费 ↗" FontSize="9.5" Foreground="#FF2563EB" Cursor="Hand" ToolTip="点击打开 DeepSeek 官方计费价格页面" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </Grid>
                  </StackPanel>

                  <!-- State B: Unconfigured / Error Guidance Panel -->
                  <StackPanel x:Name="DeepSeekMsgPanel" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,2,0,2">
                    <TextBlock x:Name="DeepSeekMsgTitle" Text="DSH 未连接" FontSize="12.5" FontWeight="Bold" Foreground="#FFCE6018" Margin="0,0,0,2" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DeepSeekMsgDetail" Text="请启动 DeepSeek Harness 查看余额" FontSize="10.5" LineStackingStrategy="BlockLineHeight" LineHeight="15" TextWrapping="Wrap" MaxHeight="46" Foreground="#FF4A2E1B"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Grid>
          </Border>
          <!-- Two Comic Droplet Bubble Tails attached below card (outside SceneText so TextFacingScale does not counter-flip) -->
          <StackPanel x:Name="BubbleTailPanel" Grid.Row="1" Orientation="Vertical" Height="26" HorizontalAlignment="Right" Margin="0,0,52,0">
            <Border x:Name="Tail" Width="18" Height="12" CornerRadius="6" HorizontalAlignment="Right" Margin="0,3.5,8,0" Background="#FFFFF6EC" BorderBrush="#FFE28532" BorderThickness="1.8" Cursor="Hand">
              <Border.RenderTransform>
                <ScaleTransform x:Name="TailScale" ScaleX="1.0" ScaleY="1.0"/>
              </Border.RenderTransform>
              <Border.Effect>
                <DropShadowEffect x:Name="TailShadow" BlurRadius="9" Direction="270" ShadowDepth="2" Opacity="0.25" Color="#885E2F0D"/>
              </Border.Effect>
            </Border>
            <Border x:Name="TailNear" Width="11.5" Height="8" CornerRadius="4" HorizontalAlignment="Right" Margin="0,2.5,0,0" Background="#FFFFF6EC" BorderBrush="#FFE28532" BorderThickness="1.5" Cursor="Hand">
              <Border.RenderTransform>
                <ScaleTransform x:Name="TailNearScale" ScaleX="1.0" ScaleY="1.0"/>
              </Border.RenderTransform>
              <Border.Effect>
                <DropShadowEffect x:Name="TailNearShadow" BlurRadius="7" Direction="270" ShadowDepth="2" Opacity="0.23" Color="#885E2F0D"/>
              </Border.Effect>
            </Border>
          </StackPanel>
        </Grid>

        <!-- Character Image Host (with bottom-center anchor for Q-bounce) -->
        <Canvas x:Name="PetHost" Canvas.Left="154" Canvas.Top="170" Width="204" Height="204" RenderTransformOrigin="0.5,1.0">
          <Canvas.RenderTransform>
            <ScaleTransform x:Name="PetScale" ScaleX="1.0" ScaleY="1.0"/>
          </Canvas.RenderTransform>
          <Image x:Name="PetImage" Canvas.Left="0" Canvas.Top="0" Width="204" Height="204"
                 Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Cursor="Hand"
                 ToolTip="左键点按看状态/额度，点气泡看语录；按住拖动位置；右键打开设置菜单"/>
        </Canvas>

      </Canvas>
    </Canvas>
  </Viewbox>
</Window>
