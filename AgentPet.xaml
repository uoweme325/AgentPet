<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="AgentPet v1.6.6 · 智能体桌宠" Width="390" Height="390" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="{x:Null}"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        FontFamily="Microsoft YaHei UI, Segoe UI" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="ThemeAccentBrush" Color="#FFCE6018"/>
    <SolidColorBrush x:Key="ThemeHoverBrush" Color="#22CE6018"/>
    <SolidColorBrush x:Key="GrantPaperBrush" Color="#FFE4D2"/>
    <SolidColorBrush x:Key="GrantInkBrush" Color="#C56736"/>
    <!-- Overscan leaves room for the shared shadow. Only the two punches cut through the paper. -->
    <GeometryGroup x:Key="QuotaTicketPunches" FillRule="EvenOdd">
      <RectangleGeometry Rect="-40,-40,334,218"/>
      <EllipseGeometry RadiusX="4.5" RadiusY="4.5" Center="175,0"/>
      <EllipseGeometry RadiusX="4.5" RadiusY="4.5" Center="175,104"/>
    </GeometryGroup>
    <Geometry x:Key="RefreshPendingGlyph">M 7,1 A 6,6 0 1 1 7,13 A 6,6 0 1 1 7,1 Z M 7,3.5 V 7 L 9.5,8.5</Geometry>
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
    </Style>
    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Border x:Name="BtnBody" Background="{TemplateBinding Background}" CornerRadius="6"
                      Width="24" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                  <ContentPresenter x:Name="IconContent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <Path x:Name="PendingGlyph" Data="{StaticResource RefreshPendingGlyph}" Width="13" Height="13" Stretch="Uniform"
                        Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="BtnBody" Property="Background" Value="{DynamicResource ThemeHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="BtnBody" Property="Opacity" Value="0.65"/>
              </Trigger>
              <Trigger Property="Tag" Value="Refreshing">
                <Setter Property="Cursor" Value="Arrow"/>
                <Setter TargetName="BtnBody" Property="Background" Value="{DynamicResource ThemeHoverBrush}"/>
                <Setter TargetName="IconContent" Property="Visibility" Value="Hidden"/>
                <Setter TargetName="PendingGlyph" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DeepSeekChipBtn" TargetType="Button">
      <Setter Property="Background" Value="#70FFFFFF"/>
      <Setter Property="BorderBrush" Value="#85FFFFFF"/>
      <Setter Property="BorderThickness" Value="0.75"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Border x:Name="ChipBody" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5.5" Padding="{TemplateBinding Padding}"
                      MinWidth="18" MinHeight="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                  <ContentPresenter x:Name="IconContent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <Path x:Name="PendingGlyph" Data="{StaticResource RefreshPendingGlyph}" Width="13" Height="13" Stretch="Uniform"
                        Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ChipBody" Property="Background" Value="{DynamicResource ThemeHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ChipBody" Property="Opacity" Value="0.65"/>
              </Trigger>
              <Trigger Property="Tag" Value="Refreshing">
                <Setter Property="Cursor" Value="Arrow"/>
                <Setter TargetName="ChipBody" Property="Background" Value="{DynamicResource ThemeHoverBrush}"/>
                <Setter TargetName="IconContent" Property="Visibility" Value="Hidden"/>
                <Setter TargetName="PendingGlyph" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <sys:String x:Key="DetailWindowXaml" xml:space="preserve"><![CDATA[
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AgentPet 任务详情"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="{x:Null}" ShowInTaskbar="False" ShowActivated="False"
        Focusable="False" Topmost="True" SizeToContent="WidthAndHeight"
        FontFamily="Microsoft YaHei UI, Segoe UI" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="DetailScrollThumbBrush" Color="#FF80502E"/>
    <SolidColorBrush x:Key="DetailScrollTrackBrush" Color="#FFF3E2D2"/>
    <Color x:Key="DetailScrollSurfaceColor">#FFFFF6EC</Color>
    <Color x:Key="DetailScrollClearColor">#00FFF6EC</Color>
    <Style x:Key="DetailScrollPageButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DetailScrollBarStyle" TargetType="ScrollBar">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Border Width="4" HorizontalAlignment="Center" CornerRadius="2"
                      Background="{DynamicResource DetailScrollTrackBrush}" IsHitTestVisible="False"/>
              <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource DetailScrollPageButton}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Focusable="False">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                          <Border x:Name="ThumbFill" Width="4" HorizontalAlignment="Center" CornerRadius="2"
                                  Background="{DynamicResource DetailScrollThumbBrush}" Opacity="0.58"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbFill" Property="Opacity" Value="0.82"/>
                          </Trigger>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbFill" Property="Opacity" Value="1"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource DetailScrollPageButton}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="DetailRootGrid" Margin="10,6,10,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Polygon x:Name="DetailArrowTop" Grid.Row="0" Points="0,7 7,0 14,7"
             Fill="#FFFFF6EC" Stroke="#FFE28532" StrokeThickness="1.6"
             StrokeLineJoin="Round" HorizontalAlignment="Center" Margin="0,0,0,-1.5" Panel.ZIndex="2"/>
    <Border x:Name="DetailCardBorder" Grid.Row="1" MinWidth="264" MaxWidth="360"
            Background="#FFFFF6EC" BorderBrush="#FFE28532" BorderThickness="1.8"
            CornerRadius="15" Padding="12,10" Panel.ZIndex="1">
      <Border.Effect>
        <DropShadowEffect Color="#555E2F0D" BlurRadius="14" ShadowDepth="3" Opacity="0.28"/>
      </Border.Effect>
      <StackPanel x:Name="DetailCardStack">
        <Grid x:Name="DetailHeaderGrid" Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="DetailTitleText" Grid.Column="0" Text="任务详情"
                     FontSize="12.5" FontWeight="Bold" Foreground="#FF4A2E1B" VerticalAlignment="Center"/>
          <Border x:Name="DetailSourcePill" Grid.Column="1" HorizontalAlignment="Right"
                  Background="#FFEFF6FF" BorderBrush="#FFBFDBFE" BorderThickness="1.0"
                  CornerRadius="10" Padding="6,2,7,2" Margin="8,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Image x:Name="DetailSourceIcon" Width="12" Height="12" Margin="0,0,4,0"
                     VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
              <TextBlock x:Name="DetailSourceMetaText" Text="Antigravity · 工作中"
                         FontSize="10" FontWeight="SemiBold" Foreground="#FF1D4ED8" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
        </Grid>
        <Border x:Name="DetailHintBanner" Background="#FFFFEAD3" BorderBrush="#FFF7D9BC"
                BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,0,0,7" Visibility="Visible">
          <TextBlock x:Name="DetailHintText" Text="状态提示：正在执行"
                     FontSize="10.5" Foreground="#FF8F5B36" TextWrapping="Wrap"/>
        </Border>
         <Grid>
           <ScrollViewer x:Name="DetailScrollViewer" MaxHeight="220"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         Focusable="False" PanningMode="VerticalOnly">
             <ScrollViewer.Resources>
               <Style TargetType="ScrollBar" BasedOn="{StaticResource DetailScrollBarStyle}"/>
             </ScrollViewer.Resources>
             <TextBlock x:Name="DetailBodyText" Text="" FontSize="12"
                        LineStackingStrategy="BlockLineHeight" LineHeight="18"
                        TextWrapping="Wrap" Foreground="#FF4A2E1B"/>
           </ScrollViewer>
           <Canvas VerticalAlignment="Top" Height="9" IsHitTestVisible="False">
             <Border x:Name="DetailScrollFadeTop" Height="9" Width="{Binding ViewportWidth, ElementName=DetailScrollViewer}"
                     Visibility="Hidden">
               <Border.Background>
                 <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                   <GradientStop Color="{DynamicResource DetailScrollSurfaceColor}" Offset="0"/>
                   <GradientStop Color="{DynamicResource DetailScrollClearColor}" Offset="1"/>
                 </LinearGradientBrush>
               </Border.Background>
             </Border>
           </Canvas>
           <Canvas VerticalAlignment="Bottom" Height="9" IsHitTestVisible="False">
             <Border x:Name="DetailScrollFadeBottom" Height="9" Width="{Binding ViewportWidth, ElementName=DetailScrollViewer}"
                     Visibility="Hidden">
               <Border.Background>
                 <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                   <GradientStop Color="{DynamicResource DetailScrollSurfaceColor}" Offset="0"/>
                   <GradientStop Color="{DynamicResource DetailScrollClearColor}" Offset="1"/>
                 </LinearGradientBrush>
               </Border.Background>
             </Border>
           </Canvas>
         </Grid>
        <Border x:Name="DetailFooterBorder" BorderBrush="#FFF3E2D2" BorderThickness="0,1,0,0"
                Margin="0,8,0,0" Padding="0,6,0,0">
          <TextBlock x:Name="DetailFooterText" Text="同源会话：1 个"
                     FontSize="10.5" Foreground="#FF8F5B36" TextWrapping="Wrap"/>
        </Border>
      </StackPanel>
    </Border>
    <Polygon x:Name="DetailArrowBottom" Grid.Row="2" Points="0,0 14,0 7,7"
             Fill="#FFFFF6EC" Stroke="#FFE28532" StrokeThickness="1.6"
             StrokeLineJoin="Round" HorizontalAlignment="Center" Margin="0,-1.5,0,0"
             Panel.ZIndex="2" Visibility="Collapsed"/>
  </Grid>
</Window>
    ]]></sys:String>
  </Window.Resources>

  <Viewbox x:Name="ScaleHost" Stretch="Uniform">
    <Canvas x:Name="AnimationStage" Width="390" Height="390">
      <Canvas x:Name="Root" Canvas.Left="8" Canvas.Top="8" Width="374" Height="374" RenderTransformOrigin="0.5,1.0">
        <Canvas.RenderTransform>
          <TransformGroup>
            <ScaleTransform x:Name="FacingScale" ScaleX="1.0" ScaleY="1.0"/>
          </TransformGroup>
        </Canvas.RenderTransform>

        <!-- Main Speech Bubble (Scheme 3 Journal Card + Attached Droplet Tail Panel) -->
        <Grid x:Name="Bubble" Canvas.Left="30" Canvas.Top="41" Width="254" Height="Auto" Cursor="Hand" Opacity="0" Visibility="Hidden" RenderTransformOrigin="0.50,0.831">
          <Grid.RenderTransform>
            <ScaleTransform x:Name="BubbleScale" ScaleX="1.0" ScaleY="1.0"/>
          </Grid.RenderTransform>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border x:Name="BubbleBorder" Grid.Row="0" Width="254" MinHeight="72" MaxHeight="128" Background="#FFFFF6EC" BorderBrush="#FFE28532" BorderThickness="2.2" CornerRadius="18" Padding="0">
            <Border.Effect>
              <DropShadowEffect x:Name="BubbleShadow" BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.26" Color="#885E2F0D"/>
            </Border.Effect>
            <Grid x:Name="SceneText" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <ScaleTransform x:Name="TextFacingScale" ScaleX="1.0" ScaleY="1.0"/>
              </Grid.RenderTransform>

              <!-- 1. Work Status Mode (Two-Tier Journal Banner + Watermark Body) -->
              <Grid x:Name="WorkStatusPanel" Visibility="Collapsed" VerticalAlignment="Stretch" Margin="0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border x:Name="WorkHeaderBanner" Grid.Row="0" BorderBrush="#FFF7D9BC" BorderThickness="0,0,0,1" CornerRadius="15.8,15.8,0,0" Padding="12,6,11,6">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop x:Name="WorkHeaderGradStop0" Color="#FFFFEAD3" Offset="0"/>
                      <GradientStop x:Name="WorkHeaderGradStop1" Color="#FFFFF2E2" Offset="1"/>
                    </LinearGradientBrush>
                  </Border.Background>
                  <StackPanel>
                    <Grid x:Name="WorkHeaderRow" Margin="0" Background="Transparent">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Border x:Name="WorkStateChip" Grid.Column="0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0" Padding="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <Ellipse x:Name="WorkDot" Width="8.5" Height="8.5" Fill="#FFCE6018" VerticalAlignment="Center" Margin="0,0,6,0"/>
                          <TextBlock x:Name="WorkHeader" Text="工作中" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#FFCE6018"/>
                        </StackPanel>
                      </Border>
                      <TextBlock x:Name="WorkCoopHintInline" Grid.Column="1" Text=" · 同时活跃" FontSize="9.5" FontWeight="SemiBold" Foreground="#FFA66838" VerticalAlignment="Center" Visibility="Collapsed" TextTrimming="CharacterEllipsis" Margin="2,0,0,0"/>
                      <Grid x:Name="WorkInlineSourceHost" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed" Background="Transparent"/>
                      <Button x:Name="WorkDetailButton" Grid.Column="3" Width="24" Height="20" Margin="5,0,0,0"
                              Padding="0" VerticalAlignment="Center" Visibility="Collapsed"
                              ToolTip="查看任务详情" AutomationProperties.Name="查看任务详情">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource DeepSeekChipBtn}">
                            <Style.Triggers>
                              <Trigger Property="Tag" Value="Pinned">
                                <Setter Property="Background" Value="{DynamicResource ThemeHoverBrush}"/>
                              </Trigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                        <Path Data="M 1.5,1.5 H 12.5 V 11.5 H 1.5 Z M 4,4.5 H 10 M 4,7.5 H 10"
                              Stroke="{DynamicResource ThemeAccentBrush}" StrokeThickness="1.2" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                      </Button>
                    </Grid>
                    <WrapPanel x:Name="WorkSourcesPanel" Orientation="Horizontal" Margin="0,3.5,0,0" Background="Transparent" Visibility="Collapsed">
                      <Border x:Name="WorkSourceBadge" Background="#DDFFFFFF" BorderBrush="#FFBFDBFE" BorderThickness="0.9" CornerRadius="8.5" Padding="5,1,5.5,1" Margin="0,0,4,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <Image x:Name="WorkSourceIcon" Width="13" Height="13" Margin="0,0,4,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                          <TextBlock x:Name="WorkSource" Text="Antigravity" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" Foreground="#FF1D4ED8"/>
                          <TextBlock x:Name="WorkSourceCount" Text="×2" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#FF64748B" Visibility="Collapsed"/>
                        </StackPanel>
                      </Border>
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <Grid x:Name="WorkBodyArea" Grid.Row="1" Background="Transparent" ClipToBounds="True">
                  <Canvas IsHitTestVisible="False" Panel.ZIndex="0">
                    <Image x:Name="WorkBodyWatermark" Canvas.Right="7" Canvas.Bottom="0" Width="34" Height="34"
                           MaxHeight="{Binding ActualHeight, ElementName=WorkBodyArea}" Stretch="Uniform"
                           Opacity="0.28" RenderOptions.BitmapScalingMode="HighQuality"/>
                  </Canvas>
                  <Grid x:Name="WorkContentGroup" VerticalAlignment="Top" Margin="13,9,13,11" Panel.ZIndex="1">
                    <TextBlock x:Name="WorkTask" Text="正在梳理接下来要做什么" FontSize="12.5" TextWrapping="Wrap" LineStackingStrategy="BlockLineHeight" LineHeight="18" VerticalAlignment="Top" TextTrimming="CharacterEllipsis" Foreground="#FF4A2E1B" Background="Transparent"/>
                  </Grid>
                </Grid>
              </Grid>

              <!-- Codex quota ticket: the right stub shares one perforation and one stamp per role. -->
              <Grid x:Name="QuotaPanel" Grid.IsSharedSizeScope="True" Visibility="Visible">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition x:Name="QuotaStubColumn" Width="78"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.ColumnSpan="2" CornerRadius="12,12,0,0" BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource QuotaRuleBrush}" IsHitTestVisible="False">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop x:Name="QuotaHeaderWash" Offset="0" Color="#FFFFF4EA"/>
                      <GradientStop x:Name="QuotaHeaderPaper" Offset="1" Color="#FFFFFCFA"/>
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
                <Grid x:Name="QuotaHeaderRow" Grid.ColumnSpan="2" Margin="8,0,4,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Image x:Name="QuotaSourceIcon" Width="13" Height="13" Margin="0,0,4,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                  <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="QuotaHeader" Text="Codex 剩余额度" FontWeight="Bold"/>
                  </Viewbox>
                  <DockPanel Grid.Column="2" Margin="4,0,1,0" VerticalAlignment="Center">
                    <Border x:Name="QuotaPlanBadge" DockPanel.Dock="Left" Visibility="Collapsed" CornerRadius="4"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Padding="4,0">
                      <TextBlock x:Name="QuotaPlanText" Text="Plus" FontWeight="SemiBold" MaxWidth="48" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </Border>
                    <TextBlock x:Name="QuotaResetNotice" Text="" Margin="2,0,0,0" VerticalAlignment="Center"
                               TextAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                  </DockPanel>
                  <Button x:Name="RefreshQuotaBtn" Grid.Column="3" Style="{StaticResource DeepSeekChipBtn}" MinWidth="31" MinHeight="31" Padding="2,0"
                          Background="{DynamicResource QuotaStubBrush}" BorderBrush="{DynamicResource QuotaRuleBrush}" Content="↻" FontSize="14"
                          FontWeight="Bold" AutomationProperties.Name="立即刷新 Codex 额度" ToolTip="立即刷新 Codex 额度"/>
                </Grid>
                <Border Grid.Column="1" Grid.Row="1" Grid.RowSpan="2" Margin="1,1,1,2" CornerRadius="5,5,10,5"
                        IsHitTestVisible="False" Background="{DynamicResource QuotaStubBrush}"/>
                <Line x:Name="QuotaTearLine" Grid.Column="1" Grid.Row="1" Grid.RowSpan="2" Width="1" HorizontalAlignment="Left"
                      X1="0" X2="0" Y1="0" Y2="1" Stretch="Fill" Margin="0,2,0,3" Stroke="{DynamicResource ThemeBorderBrush}"
                      StrokeThickness="0.8" StrokeDashArray="2,3" IsHitTestVisible="False"/>
                <Border Grid.ColumnSpan="2" Grid.Row="1" Height="1" Margin="8,0,6,0" VerticalAlignment="Bottom"
                        IsHitTestVisible="False" Background="{DynamicResource QuotaRuleBrush}"/>
                <Grid x:Name="QuotaShortRow" Grid.Row="1" Margin="9,0,10,0" VerticalAlignment="Center">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="QuotaLabelColumn"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="ShortLabel" LineStackingStrategy="BlockLineHeight" Text="5 小时" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <TextBlock x:Name="ShortReset" LineStackingStrategy="BlockLineHeight" Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Center"
                             Text="实时同步中" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                  <TextBlock x:Name="QuotaShortCaption" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed"
                             Foreground="{Binding Foreground, ElementName=ShortReset}" FontSize="{Binding FontSize, ElementName=ShortReset}"
                             LineStackingStrategy="BlockLineHeight" LineHeight="{Binding LineHeight, ElementName=ShortReset}"
                             TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                  <Border x:Name="ShortTrack" Grid.Row="2" Grid.ColumnSpan="2" Height="4" CornerRadius="2" Margin="0,3,0,0" IsHitTestVisible="False">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="0*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Border x:Name="ShortBar" CornerRadius="2"/>
                    </Grid>
                  </Border>
                </Grid>
                <Grid Grid.Row="1" Grid.Column="1" Margin="4,0,6,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ShortStubValueColumn" Width="Auto"/></Grid.ColumnDefinitions>
                  <Image x:Name="ShortQuotaStamp" Width="20" Height="20"
                         Stretch="Uniform" IsHitTestVisible="False" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Style>
                      <Style TargetType="Image"><Style.Triggers>
                        <DataTrigger Binding="{Binding Visibility, ElementName=ShortQuotaAlert}" Value="Visible">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers></Style>
                    </Image.Style>
                  </Image>
                  <TextBlock x:Name="ShortQuotaAlert" Visibility="Collapsed" FontWeight="SemiBold" FontFamily="Segoe UI Symbol, Microsoft YaHei UI"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <StackPanel x:Name="QuotaResetClock" Grid.Column="1" VerticalAlignment="Center" Visibility="Collapsed"
                              ToolTip="{Binding Text, ElementName=QuotaShortCaption}">
                    <TextBlock x:Name="QuotaClockDay" TextAlignment="Right" Foreground="{Binding Foreground, ElementName=ShortReset}"
                               FontSize="{Binding FontSize, ElementName=QuotaResetNotice}"/>
                    <TextBlock x:Name="QuotaClockTime" TextAlignment="Right" FontWeight="Bold" Typography.NumeralAlignment="Tabular"
                               Foreground="{Binding Foreground, ElementName=WeekLabel}" FontSize="{Binding FontSize, ElementName=QuotaHeader}"/>
                  </StackPanel>
                  <TextBlock x:Name="ShortPercent" TextAlignment="Right" Grid.Column="1" FontFamily="Georgia, Segoe UI" Typography.NumeralAlignment="Tabular"
                             Typography.NumeralStyle="Lining" FontWeight="Bold" VerticalAlignment="Center"><Run x:Name="ShortPercentValue" Text="—"/><Run Text="" FontFamily="Segoe UI" FontSize="{Binding FontSize, ElementName=QuotaResetNotice}" FontWeight="Normal"/></TextBlock>
                </Grid>
                <Grid x:Name="QuotaWeekRow" Grid.Row="2" Margin="9,0,10,0" VerticalAlignment="Center">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="QuotaLabelColumn"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="WeekLabel" LineStackingStrategy="BlockLineHeight" Text="每周" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <TextBlock x:Name="WeekReset" LineStackingStrategy="BlockLineHeight" Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Center"
                             Text="实时同步中" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                  <Border x:Name="WeekTrack" Grid.Row="2" Grid.ColumnSpan="2" Height="4" CornerRadius="2" Margin="0,3,0,0" IsHitTestVisible="False">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="0*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Border x:Name="WeekBar" CornerRadius="2"/>
                    </Grid>
                  </Border>
                </Grid>
                <Grid Grid.Row="2" Grid.Column="1" Margin="4,0,6,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="WeekStubValueColumn" Width="Auto"/></Grid.ColumnDefinitions>
                  <Image x:Name="WeekQuotaStamp" Source="{Binding Source, ElementName=ShortQuotaStamp}" Width="20" Height="20"
                         Stretch="Uniform" IsHitTestVisible="False" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Style>
                      <Style TargetType="Image"><Style.Triggers>
                        <DataTrigger Binding="{Binding Visibility, ElementName=WeekQuotaAlert}" Value="Visible">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers></Style>
                    </Image.Style>
                  </Image>
                  <TextBlock x:Name="WeekQuotaAlert" Visibility="Collapsed" FontWeight="SemiBold" FontFamily="Segoe UI Symbol, Microsoft YaHei UI"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <TextBlock x:Name="WeekPercent" TextAlignment="Right" Grid.Column="1" FontFamily="Georgia, Segoe UI" Typography.NumeralAlignment="Tabular"
                             Typography.NumeralStyle="Lining" FontWeight="Bold" VerticalAlignment="Center"><Run x:Name="WeekPercentValue" Text="—"/><Run Text="" FontFamily="Segoe UI" FontSize="{Binding FontSize, ElementName=QuotaResetNotice}" FontWeight="Normal"/></TextBlock>
                </Grid>
              </Grid>

              <!-- 3. Character Quote Mode -->
              <StackPanel x:Name="QuotePanel" Visibility="Collapsed" VerticalAlignment="Center">
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="QuoteSpeaker" Grid.Column="0" Text="Claude娘（小克）" FontSize="12.5" FontWeight="Bold"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#FFA94713"
                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                  <Button x:Name="QuoteHintBadge" Grid.Column="1" Style="{StaticResource DeepSeekChipBtn}" Background="#FFF5E8DC"
                          BorderThickness="0" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="换一句台词">
                    <TextBlock x:Name="QuoteHint" Text="换一句 ↻" FontSize="10" FontWeight="SemiBold" Foreground="#FFA65518" VerticalAlignment="Center"/>
                  </Button>
                </Grid>
                <TextBlock x:Name="QuoteText" Text="诗人的灵感可没有枯竭，红茶也正好泡好~" FontSize="13.5" TextWrapping="Wrap"
                           MaxHeight="60" LineHeight="20" LineStackingStrategy="BlockLineHeight" FontWeight="Normal"
                           TextTrimming="CharacterEllipsis" Foreground="#FF4D3322"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
              </StackPanel>
              <!-- 4. DeepSeek Balance Mode (Scheme 3 Journal Header + Frosted Glass Mist Card) -->
              <Grid x:Name="DeepSeekPanel" Visibility="Collapsed" VerticalAlignment="Stretch" Margin="0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Gradient Journal Banner -->
                <Border x:Name="DeepSeekHeaderBanner" Grid.Row="0" BorderBrush="#FFF7D9BC" BorderThickness="0,0,0,1" CornerRadius="15.8,15.8,0,0" Padding="10,4,8.5,4">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                      <GradientStop x:Name="DeepSeekHeaderGradStop0" Color="#FFFFEAD3" Offset="0"/>
                      <GradientStop x:Name="DeepSeekHeaderGradStop1" Color="#FFFFF2E2" Offset="1"/>
                    </LinearGradientBrush>
                  </Border.Background>
                  <Grid x:Name="DeepSeekHeaderGrid" Margin="0">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                      <Image x:Name="DeepSeekIcon" Width="14" Height="14" Margin="0,0,4.5,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.RenderTransform>
                          <TranslateTransform Y="1.5"/>
                        </Image.RenderTransform>
                      </Image>
                      <TextBlock x:Name="DeepSeekHeader" Text="DeepSeek 余额" FontSize="12.2" FontWeight="SemiBold" Foreground="#FFCE6018" VerticalAlignment="Center"/>
                      <Border x:Name="DeepSeekBadge" Visibility="Collapsed" Background="#FFF7E6D5" CornerRadius="5" Padding="4.5,0.8,4.5,1.2" Margin="4,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="DeepSeekBadgeText" Text="官方" FontSize="9.0" FontWeight="SemiBold" Foreground="#FFAA5314"/>
                      </Border>
                    </StackPanel>
                    <TextBlock x:Name="DeepSeekStatusNotice" Grid.Row="0" Grid.Column="1" Text="" FontSize="10.0" Foreground="#FFA66838" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="3,0,4,0"/>
                    <Button x:Name="RefreshDeepSeekBtn" Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                            Style="{StaticResource DeepSeekChipBtn}" MinWidth="31" MinHeight="31" Padding="3,0,3,0.5"
                            Content="↻" FontSize="11.4" FontWeight="Bold" VerticalAlignment="Center"
                            AutomationProperties.Name="立即刷新 DeepSeek 余额" ToolTip="立即刷新 DeepSeek 余额"/>
                  </Grid>
                </Border>

                <!-- Body Host: Ambient Soft Aura + Frosted Glass Mist Card + Micro-Footer -->
                <Border x:Name="DeepSeekBodyHost" Grid.Row="1" CornerRadius="0,0,15.8,15.8" ClipToBounds="True" Padding="8.5,4,8.5,3.5" Background="Transparent">
                  <Grid>
                    <!-- Diffused Radial Glow & Watermark Beneath Frosted Mist -->
                    <Grid x:Name="DeepSeekAmbientLayer" IsHitTestVisible="False" Panel.ZIndex="0">
                      <Ellipse x:Name="DeepSeekGlowOrb1" Width="148" Height="92" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-16,-22,0">
                        <Ellipse.Fill>
                          <RadialGradientBrush>
                            <GradientStop x:Name="DeepSeekOrb1Stop0" Color="#36E57E28" Offset="0"/>
                            <GradientStop x:Name="DeepSeekOrb1Stop1" Color="#00E57E28" Offset="1"/>
                          </RadialGradientBrush>
                        </Ellipse.Fill>
                      </Ellipse>
                      <Ellipse x:Name="DeepSeekGlowOrb2" Width="135" Height="82" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-18,0,0,-20">
                        <Ellipse.Fill>
                          <RadialGradientBrush>
                            <GradientStop x:Name="DeepSeekOrb2Stop0" Color="#34FFEAD3" Offset="0"/>
                            <GradientStop x:Name="DeepSeekOrb2Stop1" Color="#00FFEAD3" Offset="1"/>
                          </RadialGradientBrush>
                        </Ellipse.Fill>
                      </Ellipse>
                      <TextBlock x:Name="DeepSeekWatermark" Text="✧" FontSize="28" Foreground="#24CE6018" Opacity="0.30" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24,2,0,0"/>
                    </Grid>

                    <!-- Foreground Layout: Soft Frosted Mist + Subtle Footer -->
                    <Grid Panel.ZIndex="1">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>

                      <!-- Frosted Glass Mist Container (no heavy rectangle border) -->
                      <Border x:Name="DeepSeekFrostedCard" Grid.Row="0" CornerRadius="12" BorderThickness="0.6" Padding="8.5,4,8.5,4" ClipToBounds="True">
                        <Border.Background>
                          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#50FFFFFF" Offset="0"/>
                            <GradientStop Color="#1AFFFFFF" Offset="1"/>
                          </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#5FFFFFFF" Offset="0"/>
                            <GradientStop Color="#0EFFFFFF" Offset="1"/>
                          </LinearGradientBrush>
                        </Border.BorderBrush>

                        <Grid x:Name="DeepSeekContentGrid">
                          <!-- State A: Configured & OK / Stale Balance Display -->
                          <Grid x:Name="DeepSeekOkPanel" Visibility="Visible" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                              <RowDefinition Height="*"/>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Main Row: Left Currency + Pill/Alert Line | Right Total Balance -->
                            <Grid x:Name="DeepSeekMainRowGrid" Grid.Row="0" VerticalAlignment="Center">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="DeepSeekCurrencyLabel" Text="人民币 CNY · DSH" FontSize="11.2" FontWeight="SemiBold"
                                           Foreground="#FF4A2E1B" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                <Grid x:Name="DeepSeekMetaBadgeLine" Margin="0,3,0,0" VerticalAlignment="Center">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                  </Grid.ColumnDefinitions>
                                  <Border x:Name="DeepSeekAvailPill" Grid.Column="0" Background="#A8EAFBF3" BorderBrush="#7A86EFAC" BorderThickness="0.65" CornerRadius="5.5" Padding="5.5,1.5,5.5,1.5" Margin="0,0,5.5,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                      <Ellipse x:Name="DeepSeekAvailDot" Width="5" Height="5" Fill="#FF10B981" Margin="0,0,3.5,0" VerticalAlignment="Center"/>
                                      <TextBlock x:Name="DeepSeekAvailPillText" Text="可用" FontSize="9.6" FontWeight="SemiBold" Foreground="#FF047857" VerticalAlignment="Center" LineStackingStrategy="BlockLineHeight" LineHeight="12"/>
                                    </StackPanel>
                                  </Border>
                                  <TextBlock x:Name="DeepSeekSubMetaText" Grid.Column="1" Text="预警线 ¥5.00" FontSize="9.6"
                                             Foreground="#FF854B24" VerticalAlignment="Center" LineStackingStrategy="BlockLineHeight"
                                             LineHeight="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                  <TextBlock x:Name="DeepSeekAvailableNotice" Grid.Column="2" Visibility="Collapsed" Text="" FontSize="9.4" Margin="4,0,0,0" Foreground="#FFE11D48" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                              </StackPanel>
                              <TextBlock x:Name="DeepSeekTotalText" Grid.Column="1" Text="¥ 0.00" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="20.5" FontWeight="Bold" VerticalAlignment="Center" Foreground="#FFBA4E0E" Margin="6,-1,0,0"/>
                            </Grid>

                            <!-- Middle Row: Dual-Tone Recharge / Grant Proportion Bar -->
                            <Border x:Name="DeepSeekRatioTrack" Grid.Row="1" Height="6" CornerRadius="3" Background="#A5F3E2D2" ClipToBounds="True" Margin="0,3,0,4">
                              <Grid x:Name="DeepSeekRatioGrid">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition x:Name="DeepSeekToppedUpCol" Width="1*"/>
                                  <ColumnDefinition x:Name="DeepSeekGrantCol" Width="0*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="DeepSeekFillBar" Grid.Column="0" Background="#FFE57E28" CornerRadius="3"/>
                                <Border x:Name="DeepSeekGrantBar" Grid.Column="1" CornerRadius="0,3,3,0" Margin="1.5,0,0,0" Visibility="Collapsed">
                                  <Border.Background>
                                    <DrawingBrush TileMode="Tile" Viewbox="0,0,5,5" Viewport="0,0,5,5" ViewboxUnits="Absolute" ViewportUnits="Absolute">
                                      <DrawingBrush.Drawing>
                                        <DrawingGroup ClipGeometry="M0,0 H5 V5 H0 Z">
                                          <GeometryDrawing Brush="{DynamicResource GrantPaperBrush}" Geometry="M0,0 H5 V5 H0 Z"/>
                                          <GeometryDrawing Geometry="M-1,1 L1,-1 M-1,6 L6,-1 M4,6 L6,4">
                                            <GeometryDrawing.Pen><Pen Brush="{DynamicResource GrantInkBrush}" Thickness="1.25"/></GeometryDrawing.Pen>
                                          </GeometryDrawing>
                                        </DrawingGroup>
                                      </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                  </Border.Background>
                                </Border>
                              </Grid>
                            </Border>

                            <!-- Bottom Row: Adaptive Left Recharge & Right Grant Legend -->
                            <Grid x:Name="DeepSeekSubRowGrid" Grid.Row="2">
                              <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                              </Grid.RowDefinitions>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <Grid x:Name="DeepSeekRechargeLegend" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto"/>
                                  <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="DeepSeekToppedUpDot" Grid.Column="0" Width="6" Height="6" Fill="#FFE57E28" Margin="0,0.5,4.5,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DeepSeekBreakdownText" Grid.Column="1" Text="充值 ¥0.00" FontSize="10.4" FontWeight="Medium"
                                           Foreground="#FF80502E" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                              </Grid>
                              <StackPanel x:Name="DeepSeekGrantLegend" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                <Ellipse x:Name="DeepSeekGrantDot" Width="6" Height="6" Fill="Transparent" Stroke="{DynamicResource GrantInkBrush}" StrokeThickness="1" Opacity="0.45" Margin="0,0.5,4.5,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DeepSeekGrantText" Text="赠金 ¥0.00" FontSize="10.4" Foreground="{Binding Foreground, ElementName=DeepSeekBreakdownText}"
                                           VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                              </StackPanel>
                            </Grid>
                          </Grid>

                          <!-- State B: Unconfigured / Error Guidance Panel -->
                          <Grid x:Name="DeepSeekMsgPanel" Visibility="Collapsed" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="*"/>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid x:Name="DeepSeekMsgHeaderGrid" Grid.Row="0">
                              <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                              </Grid.RowDefinitions>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <Ellipse x:Name="DeepSeekMsgDot" Grid.Row="0" Grid.Column="0" Width="6.5" Height="6.5" Fill="#FFF59E0B" Margin="0,1,5,0" VerticalAlignment="Center"/>
                              <TextBlock x:Name="DeepSeekMsgTitle" Grid.Row="0" Grid.Column="1" Text="DSH 未运行" FontSize="11.6" FontWeight="Bold" Foreground="#FFCE6018" TextWrapping="Wrap" VerticalAlignment="Center"/>
                              <Border x:Name="DeepSeekMsgStatusPill" Grid.Row="0" Grid.Column="2" Background="#A8FFFBEB" BorderBrush="#80FCD34D" BorderThickness="0.65" CornerRadius="5.5" Padding="5.5,1.5,5.5,1.5" Margin="6,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock x:Name="DeepSeekMsgStatusText" Text="宿主离线" FontSize="9.2" FontWeight="SemiBold" Foreground="#FFB45309" VerticalAlignment="Center"/>
                              </Border>
                            </Grid>
                            <TextBlock x:Name="DeepSeekMsgDetail" Grid.Row="1" Text="请启动 DeepSeek Harness 后查看余额"
                                       FontSize="10.0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       Foreground="#FF4A2E1B" Margin="0,1,0,1" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <Border x:Name="DeepSeekMsgDivider" Grid.Row="2" Height="0.75" Margin="0,1,0,3">
                              <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                  <GradientStop x:Name="DeepSeekDivStop0" Color="#50F7D9BC" Offset="0"/>
                                  <GradientStop x:Name="DeepSeekDivStop1" Color="#0AF7D9BC" Offset="1"/>
                                </LinearGradientBrush>
                              </Border.Background>
                            </Border>
                            <Grid Grid.Row="3">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <TextBlock x:Name="DeepSeekMsgSubHint" Grid.Column="0" Text="待机中 · 低额预警 ¥5.00" FontSize="9.4"
                                         Foreground="#FF854B24" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                              <TextBlock x:Name="DeepSeekMsgRightHint" Grid.Column="1" Text="点右上 ↻ 重连" FontSize="9.4" Foreground="#FF8F5B36" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                          </Grid>
                        </Grid>
                      </Border>

                      <!-- Micro-Footer Strip -->
                      <Grid x:Name="DeepSeekFooterGrid" Grid.Row="1" Margin="3,2,3,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DeepSeekFooterLeft" Grid.Column="0" Text="● 余额健康 · 已同步" FontSize="10.2"
                                   Foreground="#FF854B24" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <TextBlock x:Name="DeepSeekFooterRight" Grid.Column="1" Text="点空白处切看板" FontSize="10.2" Foreground="#FFA66838" Margin="6,0,0,0"/>
                      </Grid>
                    </Grid>
                  </Grid>
                </Border>
              </Grid>
            </Grid>
          </Border>
          <!-- Two Comic Droplet Bubble Tails attached below card (outside SceneText so TextFacingScale does not counter-flip) -->
          <StackPanel x:Name="BubbleTailPanel" Grid.Row="1" Orientation="Vertical" Height="26" HorizontalAlignment="Right" Margin="0,0,52,0">
            <Border x:Name="Tail" Width="18" Height="12" CornerRadius="6" HorizontalAlignment="Right" Margin="0,3.5,8,0" Background="#FFFFF6EC" BorderBrush="#FFE28532" BorderThickness="1.8" Cursor="Hand">
              <Border.RenderTransform>
                <ScaleTransform x:Name="TailScale" ScaleX="1.0" ScaleY="1.0"/>
              </Border.RenderTransform>
              <Border.Effect>
                <DropShadowEffect x:Name="TailShadow" BlurRadius="9" Direction="270" ShadowDepth="2" Opacity="0.25" Color="#885E2F0D"/>
              </Border.Effect>
            </Border>
            <Border x:Name="TailNear" Width="11.5" Height="8" CornerRadius="4" HorizontalAlignment="Right" Margin="0,2.5,0,0" Background="#FFFFF6EC" BorderBrush="#FFE28532" BorderThickness="1.5" Cursor="Hand">
              <Border.RenderTransform>
                <ScaleTransform x:Name="TailNearScale" ScaleX="1.0" ScaleY="1.0"/>
              </Border.RenderTransform>
              <Border.Effect>
                <DropShadowEffect x:Name="TailNearShadow" BlurRadius="7" Direction="270" ShadowDepth="2" Opacity="0.23" Color="#885E2F0D"/>
              </Border.Effect>
            </Border>
          </StackPanel>
        </Grid>

        <!-- Character Image Host (with bottom-center anchor for Q-bounce) -->
        <Canvas x:Name="PetHost" Canvas.Left="154" Canvas.Top="170" Width="204" Height="204" RenderTransformOrigin="0.5,1.0">
          <Canvas.RenderTransform>
            <ScaleTransform x:Name="PetScale" ScaleX="1.0" ScaleY="1.0"/>
          </Canvas.RenderTransform>
          <Image x:Name="PetImage" Canvas.Left="0" Canvas.Top="0" Width="204" Height="204"
                 Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Cursor="Hand"
                 ToolTip="左键点按看状态/额度，点气泡看语录；按住拖动位置；右键打开设置菜单"/>
        </Canvas>

      </Canvas>
    </Canvas>
  </Viewbox>
</Window>
